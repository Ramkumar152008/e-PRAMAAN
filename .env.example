# ============================================================
# e-BID PRAMAAN — Environment Configuration Template
# Organization: Chennai Petroleum Corporation Limited (CPCL)
# ============================================================

# ─── BACKEND CONFIGURATION ──────────────────────────────────
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
DEBUG=true

# Security & Cryptographic Tokens
SECRET_KEY=ebid-pramaan-cpcl-procurement-verification-secret-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL + pgvector for Production, SQLite for Local Zero-Dependency Demo)
DATABASE_URL=sqlite:///./ebid_pramaan.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://postgres:postgres_secure_cpcl_2026@localhost:5432/ebid_pramaan

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000","*"]

# File & Document Storage Paths
UPLOAD_DIR=./uploads
DOCUMENTS_DIR=./documents
MAX_UPLOAD_SIZE_MB=50

# ─── RAG & AI INVESTIGATION LAYER ───────────────────────────
AI_PROVIDER=local_deterministic_corpus
EMBEDDING_PROVIDER=tfidf_domain_vectorizer
RAG_CONFIDENCE_THRESHOLD=0.18
HALLUCINATION_GUARD=enabled

# Optional Cloud LLM / Embedding Integrations (if authorized):
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ─── n8n WORKFLOW ORCHESTRATION ─────────────────────────────
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_CLARIFICATION=http://localhost:5678/webhook/clarification-trigger
N8N_WEBHOOK_ESCALATION=http://localhost:5678/webhook/escalation-trigger

# ─── FRONTEND CONFIGURATION ─────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api
