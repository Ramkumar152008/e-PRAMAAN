# ============================================================
# e-BID PRAMAAN — Backend Environment Template
# ============================================================

PORT=8000
ENVIRONMENT=production
DEBUG=false

# JWT Secret Key (Generate random key on Render)
SECRET_KEY=ebid-pramaan-cpcl-procurement-verification-secret-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL (SQLite for local demo, Render PostgreSQL for production)
# SQLite Example:
DATABASE_URL=sqlite:///./ebid_pramaan.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://user:password@host:5432/ebid_pramaan

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=*

# Optional n8n Workflow Orchestration URL
N8N_BASE_URL=http://localhost:5678
